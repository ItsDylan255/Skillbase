/* ============================================================
   Skillbase – Linear-inspired dark theme
   Anwenden via QApplication::setStyleSheet(...) in main.cpp,
   damit auch Dialoge ohne eigenes Root-Stylesheet
   (z.B. exercise_execution_dialog) automatisch gestylt sind.
   ============================================================
   Farbpalette
   --bg            #121214   Haupt-Hintergrund
   --bg-sidebar    #0e0e10   Sidebar-Hintergrund (dunkler)
   --surface       #19191c   Cards / Inputs / erhöhte Flächen
   --surface-hover #212124   Hover-Fläche
   --border        #29292d   Standard-Border
   --border-light  #333338   Etwas hellere Border (Hover/Focus-Trenner)
   --text-primary  #eaeaec   Haupttext
   --text-secondary#9a9aa0   Sekundärtext
   --text-muted    #6d6d73   Metadaten / Platzhalter
   --accent        #ff6f61   Skillbase-Orange
   --accent-hover  #ff8677
   --accent-pressed#e85c4e
   --danger        #e5484d   Destruktive Aktionen (nur Text)
   --success       #3fb950   Erfolg / abgeschlossen (zurückhaltend einsetzen)
   --warning       #d29922   Warnung / Achtung
   --info          #58a6ff   Neutraler Hinweis
   ============================================================
   Qt Style Sheets kennen keine CSS-Variablen - die Werte oben
   sind die Referenz, die tatsächlichen Farbwerte werden unten
   direkt in den Selektoren wiederholt.
   ============================================================ */

/* ---------- Basis ---------- */
QMainWindow, QDialog, QWidget {
    background-color: #121214;
    color: #eaeaec;
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 13px;
}
QToolButton#goalCurrentButton {
    padding: 0;
    border: none;
    border-bottom: none;
    background: transparent;
    border-radius: 6px;
}

QToolButton#goalCurrentButton:hover {
    background-color: #212124;
}
/* Labels sollen standardmäßig keine eigene Fläche zeichnen.
   Dadurch bleibt innerhalb von Cards deren Surface sichtbar. */
QLabel {
    background-color: transparent;
}

QWidget:disabled {
    color: #55555a;
}

QToolTip {
    background-color: #19191c;
    color: #eaeaec;
    border: 1px solid #29292d;
    padding: 4px 8px;
    border-radius: 4px;
}

/* ---------- Sidebar ---------- */
#sidebar {
    background-color: #0e0e10;
}

QFrame#line {
    background-color: #29292d;
    max-width: 1px;
    min-width: 1px;
    border: none;
}

QLabel#sidebarTitleLabel {
    font-size: 16px;
    font-weight: 600;
    color: #eaeaec;
    padding: 8px 4px 16px 4px;
}

QLabel#sidebarHobbySectionLabel {
    font-size: 11px;
    font-weight: 600;
    color: #6d6d73;
    padding: 12px 4px 4px 4px;
}

#sidebar QPushButton {
    background-color: transparent;
    border: none;
    border-left: 2px solid transparent;
    border-radius: 0px;
    color: #9a9aa0;
    text-align: left;
    padding: 8px 10px 8px 8px;
    font-size: 13px;
    font-weight: 500;
}

#sidebar QPushButton:hover {
    background-color: #212124;
    color: #eaeaec;
}

#sidebar QPushButton:pressed {
    background-color: #29292d;
}

/* Aktiver Menüpunkt: dezenter Accent-Indikator am linken Rand statt
   einer vollflächigen Farbfläche (siehe ui-guidelines.md, "Navigation"). */
#sidebar QPushButton:checked {
    background-color: transparent;
    border-left: 2px solid #ff6f61;
    color: #eaeaec;
    font-weight: 600;
}

#sidebar QListWidget {
    background-color: transparent;
    border: none;
}

/* ---------- Seiten-/Section-Titel ---------- */
QLabel#dashboardTitleLabel,
QLabel#hobbyLabel,
QLabel#settingsTitleLabel,
QLabel#statisticsTitleLabel {
    font-size: 22px;
    font-weight: 600;
    color: #eaeaec;
    padding-bottom: 4px;
}

/* Tab-Section-Titel innerhalb einer Hobby-Seite (Übungen/Ziele/Verlauf/
   Timeline/Roadmap) - bewusst eine Stufe kleiner als die Seiten-Titel
   oben und einheitlich für alle Tabs, damit z. B. "Ziele" und "Verlauf"
   an derselben Stelle/Größe wie "Übungen" stehen. */
QLabel#exercisesHeaderLabel,
QLabel#goalsHeaderLabel,
QLabel#routinesHeaderLabel,
QLabel#historyHeaderLabel,
QLabel#timelineHeaderLabel,
QLabel#roadmapHeaderLabel,
QLabel#roadmapInfoTitle,
QLabel#exerciseDetailNameLabel {
    font-size: 16px;
    font-weight: 600;
    color: #eaeaec;
}

/* "titleLabel" ist als Objektname doppelt vergeben: im
   Execution-Dialog die große Dialog-Überschrift ("Übung ausführen"),
   im GoalDialog dagegen nur die Feldbeschriftung von "Titel *".
   Deshalb hier bewusst auf den Execution-Dialog verankert (per
   Root-ObjectName-Selektor), statt global über QLabel#titleLabel zu
   gehen - siehe namensvorschlaege.md, Punkt 1. */
#ExerciseExecutionDialog QLabel#titleLabel {
    font-size: 16px;
    font-weight: 600;
    color: #eaeaec;
}

/* Sekundäre/Meta-Header innerhalb des Roadmap-Infopanels und des Execution-Dialogs,
   sowie die kleinen Section-Header auf der Übersicht und dem Hobby-Dashboard
   ("AKTUELLE PHASE", "ROUTINEN", "NOTIZ", "STATISTIK" usw.). */
QLabel#roadmapInfoStatusHeader,
QLabel#roadmapInfoDescriptionHeader,
QLabel#roadmapInfoParentHeader,
QLabel#exerciseLabel,
QLabel#goalTitleLabel,
QLabel#valueTitleLabel,
QLabel#durationTitleLabel,
QLabel#exerciseDetailStartHeaderLabel,
QLabel#exerciseDetailCurrentHeaderLabel,
QLabel#exerciseDetailGoalHeaderLabel,
QLabel#exerciseDetailLastPerformedHeaderLabel,
QLabel#exerciseDetailExecutionCountHeaderLabel,
QLabel#exerciseDetailTotalTimeHeaderLabel,
QLabel#todaySectionLabel,
QLabel#goalsSectionLabel,
QLabel#progressSectionLabel,
QLabel#recentActivitySectionLabel,
QLabel#hobbyPhaseSectionLabel,
QLabel#hobbyGoalSectionLabel,
QLabel#hobbyRoutinesSectionLabel,
QLabel#hobbyNoteSectionLabel,
QLabel#hobbyStatsSectionLabel {
    font-size: 11px;
    font-weight: 600;
    color: #6d6d73;
    padding-top: 8px;
}

/* Wertanzeigen im Execution-Dialog, in der Übungs-Detailansicht sowie
   die aktuelle Phase / das aktuelle Ziel im Hobby-Dashboard. */
QLabel#exerciseNameLabel,
QLabel#exerciseDetailStartValueLabel,
QLabel#exerciseDetailCurrentValueLabel,
QLabel#exerciseDetailGoalValueLabel,
QLabel#exerciseDetailLastPerformedLabel,
QLabel#exerciseDetailExecutionCountLabel,
QLabel#exerciseDetailTotalTimeLabel,
QLabel#hobbyPhaseNameLabel,
QLabel#hobbyGoalNameLabel {
    font-size: 14px;
    font-weight: 500;
    color: #eaeaec;
}

/* "goalLabel" ist als Objektname doppelt vergeben: im Execution-Dialog
   die dynamische Wertanzeige (Ziel + Einheit), im ExerciseDialog dagegen
   nur die Feldbeschriftung von "Ziel" (soll wie nameLabel/valueLabel/
   unitLabel aussehen, siehe namensvorschlaege.md, Punkt 2). */
#ExerciseExecutionDialog QLabel#goalLabel {
    font-size: 14px;
    font-weight: 500;
    color: #eaeaec;
}

QLabel#unitLabel {
    color: #9a9aa0;
}

/* Gedämpfte Body-/Hinweistexte, inkl. Untertitel der Übersicht/des
   Hobby-Dashboards und der Countdown-/Deadline-Zeilen. */
QLabel#dashboardSubtitleLabel,
QLabel#hobbyDashboardSubtitleLabel,
QLabel#hobbyPhaseCountdownLabel,
QLabel#hobbyGoalDeadlineLabel,
QLabel#hobbyRoutinesEmptyLabel,
QLabel#todayLabel,
QLabel#goalsSummaryLabel,
QLabel#progressSummaryLabel,
QLabel#hobbyTodayLabel,
QLabel#hobbyGoalsSummaryLabel,
QLabel#hobbyProgressSummaryLabel,
QLabel#historyEmptyStateLabel,
QLabel#timelineEmptyLabel,
QLabel#roadmapInfoNameLabel,
QLabel#roadmapInfoStatusLabel,
QLabel#roadmapInfoDescriptionLabel,
QLabel#roadmapInfoParentLabel,
QLabel#exerciseDetailDescriptionLabel,
QLabel#exerciseDetailPercentLabel {
    color: #9a9aa0;
    font-size: 13px;
}

/* Große Statistik-Werte im Hobby-Dashboard ("126", "34 h 20 min", ...) -
   dürfen laut ui-guidelines.md stärker hervorgehoben werden. */
QLabel#hobbyStatExercisesValueLabel,
QLabel#hobbyStatTimeValueLabel,
QLabel#hobbyStatSessionsValueLabel,
QLabel#hobbyStatGoalsValueLabel {
    font-size: 20px;
    font-weight: 700;
    color: #eaeaec;
}

QLabel#hobbyStatExercisesCaptionLabel,
QLabel#hobbyStatTimeCaptionLabel,
QLabel#hobbyStatSessionsCaptionLabel,
QLabel#hobbyStatGoalsCaptionLabel {
    font-size: 12px;
    color: #9a9aa0;
}

/* ---------- Übungs-Detailansicht ---------- */

/* Kategorie-Tag im Kopfbereich der Detailansicht (gleiche Optik wie
   die Kategorie-Tags auf den Übungskarten). */
QLabel#exerciseDetailCategoryTagLabel {
    background-color: #2a2a2a;
    color: #aaaaaa;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 11px;
    max-width: 200px;
}

/* Kleiner, zurückhaltender Link-artiger Button zum Bearbeiten des
   Startwerts - bewusst leichter als ein normaler Secondary-Button. */
QPushButton#exerciseDetailEditStartValueButton {
    background-color: transparent;
    border: none;
    color: #9a9aa0;
    font-size: 11px;
    font-weight: 500;
    padding: 2px 6px;
}

QPushButton#exerciseDetailEditStartValueButton:hover {
    color: #eaeaec;
    text-decoration: underline;
}

QPushButton#exerciseDetailEditStartValueButton:pressed {
    color: #ff6f61;
}

/* Fortschrittsbalken in der Übungs-Detailansicht */
QProgressBar#exerciseDetailProgressBar {
    background-color: #19191c;
    border: 1px solid #29292d;
    border-radius: 4px;
    height: 8px;
    max-height: 8px;
}

QProgressBar#exerciseDetailProgressBar::chunk {
    background-color: #ff6f61;
    border-radius: 4px;
}

QFrame#roadmapInfoSeparator,
QFrame#dashboardDivider1,
QFrame#dashboardDivider2,
QFrame#dashboardDivider3,
QFrame#hobbyDashboardDivider1,
QFrame#hobbyDashboardDivider2,
QFrame#hobbyDashboardDivider3,
QFrame#hobbyDashboardDivider4 {
    background-color: #29292d;
    max-height: 1px;
    border: none;
}

/* Aktuelle Phase / Aktuelles Ziel im Hobby-Dashboard: untereinander
   angeordnete, klickbare Cards - gleiche Card-Sprache wie exerciseCard/
   goalCard (Surface, dünne Border, 6px Radius), Hover nur über die Border. */
QFrame#hobbyPhaseSection,
QFrame#hobbyGoalSection {
    background-color: #19191c;
    border: 1px solid #29292d;
    border-radius: 6px;
}

QFrame#hobbyPhaseSection:hover,
QFrame#hobbyGoalSection:hover {
    background-color: #1c1c1f;
    border: 1px solid #333338;
}

/* Fortschrittsbalken der aktuellen Phase im Hobby-Dashboard - gleiche
   Optik wie der Fortschrittsbalken in der Übungs-Detailansicht. */
QProgressBar#hobbyPhaseProgressBar {
    background-color: #121214;
    border: 1px solid #29292d;
    border-radius: 4px;
    height: 8px;
    max-height: 8px;
}

QProgressBar#hobbyPhaseProgressBar::chunk {
    background-color: #ff6f61;
    border-radius: 4px;
}

/* "+ Routine hinzufügen" im Empty-State des Dashboards ist eine
   sekundäre Aktion, kein Primary-Button (davon gibt es max. einen
   pro Kontext - das ist bereits addRoutineButton auf der Routinen-Seite). */
QPushButton#hobbyRoutinesAddButton {
    padding: 6px 12px;
    font-size: 12px;
}

/* ---------- Cards (QGroupBox) ---------- */
QGroupBox {
    background-color: #19191c;
    border: 1px solid #29292d;
    border-radius: 6px;
    margin-top: 14px;
    padding: 16px 12px 12px 12px;
    font-size: 13px;
    font-weight: 600;
    color: #eaeaec;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    top: 2px;
    padding: 0 4px;
    color: #eaeaec;
    font-size: 13px;
    font-weight: 600;
}

/* ---------- Tabs (QToolButton als Hobby-Navigation & View-Toggle) ---------- */
QToolButton {
    border: none;
    background: transparent;
    padding: 8px 14px;
    color: #9a9aa0;
    font-size: 13px;
    font-weight: 500;
    border-bottom: 2px solid transparent;
}

QToolButton:hover {
    color: #eaeaec;
}

QToolButton:checked {
    color: #eaeaec;
    border-bottom: 2px solid #ff6f61;
}

/* ---------- Buttons ---------- */
QPushButton {
    background-color: #19191c;
    color: #eaeaec;
    border: 1px solid #29292d;
    border-radius: 6px;
    padding: 7px 14px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #212124;
    border-color: #333338;
}

QPushButton:pressed {
    background-color: #29292d;
}

QPushButton:disabled {
    color: #55555a;
    border-color: #212124;
    background-color: #17171a;
}

QPushButton:focus {
    border-color: #ff6f61;
    outline: none;
}

/* Primary-Buttons: alle "+ hinzufügen"-Aktionen */
QPushButton#addExerciseButton,
QPushButton#addRoutineButton,
QPushButton#addGoalButton,
QPushButton#addRoadmapGoalButton,
QPushButton#addTimelinePhaseButton,
QPushButton#addButton {
    background-color: #ff6f61;
    color: #171012;
    border: 1px solid #ff6f61;
    font-weight: 600;
}

QPushButton#addExerciseButton:hover,
QPushButton#addRoutineButton:hover,
QPushButton#addGoalButton:hover,
QPushButton#addRoadmapGoalButton:hover,
QPushButton#addTimelinePhaseButton:hover,
QPushButton#addButton:hover {
    background-color: #ff8677;
    border-color: #ff8677;
}

QPushButton#addExerciseButton:pressed,
QPushButton#addRoutineButton:pressed,
QPushButton#addGoalButton:pressed,
QPushButton#addRoadmapGoalButton:pressed,
QPushButton#addTimelinePhaseButton:pressed,
QPushButton#addButton:pressed {
    background-color: #e85c4e;
    border-color: #e85c4e;
}

/* Zurück-Buttons der Unterseiten (Fortschritt, Timeline): Ghost-Variante.
   Gleiche Höhe/Radius/Schrift wie alle QPushButtons (Padding oben/unten 7px,
   1px Border), aber ohne Fläche und mit schmalerem Horizontal-Padding,
   damit der Button kompakt bleibt und nicht stärker wirkt als der Inhalt. */
QPushButton#progressBackButton,
QPushButton#timelineBackButton {
    background-color: transparent;
    color: #9a9aa0;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 7px 10px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#progressBackButton:hover,
QPushButton#timelineBackButton:hover {
    background-color: #212124;
    color: #eaeaec;
}

QPushButton#progressBackButton:pressed,
QPushButton#timelineBackButton:pressed {
    background-color: #29292d;
    color: #eaeaec;
}

QPushButton#progressBackButton:focus,
QPushButton#timelineBackButton:focus {
    border: 1px solid #ff6f61;
    color: #eaeaec;
}

QPushButton#progressBackButton:disabled,
QPushButton#timelineBackButton:disabled {
    background-color: transparent;
    color: #55555a;
    border: 1px solid transparent;
}

/* Destruktive Aktionen: dezent über Textfarbe, keine Fläche */
QPushButton#deleteButton,
QPushButton#deletePhaseButton {
    color: #e5484d;
    border-color: #29292d;
    background-color: transparent;
}

QPushButton#deleteButton:hover,
QPushButton#deletePhaseButton:hover {
    background-color: rgba(229, 72, 77, 0.12);
    border-color: rgba(229, 72, 77, 0.35);
}

QPushButton#deleteButton:pressed,
QPushButton#deletePhaseButton:pressed {
    background-color: rgba(229, 72, 77, 0.20);
    border-color: rgba(229, 72, 77, 0.50);
}

QPushButton#deleteButton:disabled,
QPushButton#deletePhaseButton:disabled {
    color: #55555a;
    border-color: #212124;
    background-color: transparent;
}

/* QDialogButtonBox Buttons (Save/Cancel) */
QDialogButtonBox QPushButton {
    min-width: 84px;
}

/* Die primäre Aktion eines Dialogs (Speichern/Erstellen) wird als
   Default-Button gesetzt und erhält dieselbe Primary-Button-Farbe
   wie "+ hinzufügen"-Aktionen (siehe oben). */
QDialogButtonBox QPushButton[default="true"] {
    background-color: #ff6f61;
    color: #171012;
    border: 1px solid #ff6f61;
    font-weight: 600;
}

QDialogButtonBox QPushButton[default="true"]:hover {
    background-color: #ff8677;
    border-color: #ff8677;
}

QDialogButtonBox QPushButton[default="true"]:pressed {
    background-color: #e85c4e;
    border-color: #e85c4e;
}

QDialogButtonBox QPushButton[default="true"]:disabled {
    background-color: #17171a;
    color: #55555a;
    border-color: #212124;
}

/* ---------- Inputs ---------- */
QLineEdit, QPlainTextEdit, QTextEdit {
    background-color: #19191c;
    border: 1px solid #29292d;
    border-radius: 6px;
    padding: 7px 10px;
    color: #eaeaec;
    selection-background-color: #ff6f61;
    selection-color: #171012;
}

QLineEdit:hover, QPlainTextEdit:hover, QTextEdit:hover {
    border-color: #333338;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus {
    border-color: #ff6f61;
}

QLineEdit:disabled, QPlainTextEdit:disabled {
    background-color: #17171a;
    color: #55555a;
}

QComboBox {
    background-color: #19191c;
    border: 1px solid #29292d;
    border-radius: 6px;
    padding: 6px 10px;
    color: #eaeaec;
}

QComboBox:hover {
    border-color: #333338;
}

QComboBox:focus {
    border-color: #ff6f61;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #19191c;
    border: 1px solid #29292d;
    border-radius: 6px;
    color: #eaeaec;
    selection-background-color: #29292d;
    selection-color: #eaeaec;
    outline: none;
}

QDateEdit {
    background-color: #19191c;
    border: 1px solid #29292d;
    border-radius: 6px;
    padding: 6px 10px;
    color: #eaeaec;
    selection-background-color: #ff6f61;
    selection-color: #171012;
}

QDateEdit:hover {
    border-color: #333338;
}

QDateEdit:focus {
    border-color: #ff6f61;
}

QDateEdit:disabled {
    background-color: #17171a;
    color: #55555a;
}

QDateEdit::drop-down {
    border: none;
    width: 20px;
}

/* ---------- Listen / Trees ---------- */
QListWidget, QTreeWidget {
    background-color: #19191c;
    border: 1px solid #29292d;
    border-radius: 6px;
    padding: 4px;
    color: #eaeaec;
    outline: none;
}

QListWidget::item, QTreeWidget::item {
    padding: 6px 8px;
    border-radius: 4px;
}

QListWidget::item:hover, QTreeWidget::item:hover {
    background-color: #212124;
}

QListWidget::item:selected, QTreeWidget::item:selected {
    background-color: rgba(255, 111, 97, 0.15);
    color: #eaeaec;
}

QTreeWidget {
    show-decoration-selected: 1;
}

QHeaderView::section {
    background-color: #19191c;
    color: #9a9aa0;
    padding: 6px 8px;
    border: none;
    border-bottom: 1px solid #29292d;
    font-weight: 600;
}

/* ---------- Verlauf: History Entry Row ---------- */
HistoryEntryWidget {
    background-color: transparent;
    border-radius: 6px;
}

HistoryEntryWidget:hover {
    background-color: #212124;
}

/* Rollenbasierte Textfarben (dynamic property "role" auf QLabel, siehe HistoryEntryWidget) */
QLabel[role="secondary"] {
    color: #9a9aa0;
}

QLabel[role="muted"] {
    color: #6d6d73;
}

QLabel[role="accent"] {
    color: #ff6f61;
}

QLabel[role="success"] {
    color: #3fb950;
}

QLabel[role="warning"] {
    color: #d29922;
}

QLabel[role="info"] {
    color: #58a6ff;
}

/* ---------- Verlauf: Datums-Trenner ---------- */
HistoryDateHeaderWidget {
    background-color: transparent;
    border-bottom: 1px solid #29292d;
}

HistoryDateHeaderWidget QLabel#dateLabel {
    font-size: 11px;
    font-weight: 600;
    color: #6d6d73;
}

/* Eintragstitel im Verlauf (fett, wie jeder andere Primary-Body-Text) */
QLabel#entryTitleLabel {
    font-size: 13px;
    font-weight: 600;
    color: #eaeaec;
}

/* "Zeitraum"-Zwischenüberschrift im TimelinePhaseDialog - gleiche
   Optik wie eine Feld-Gruppenüberschrift, etwas stärker als die
   einfachen Feldbeschriftungen (Name/Beschreibung) darüber. */
QLabel#periodLabel {
    font-size: 13px;
    font-weight: 600;
    color: #eaeaec;
}

/* Status-Punkt vor jedem Verlaufseintrag: kleiner, echter Kreis statt
   Font-Glyph ("●"), damit Größe/Position pixelgenau und rendererunabhängig
   sind. Farbe kommt weiterhin über die role-Property (aktuell "accent"). */
QLabel#entryTypeIconLabel {
    background-color: #ff6f61;
    border-radius: 4px;
    min-width: 8px;
    max-width: 8px;
    min-height: 8px;
    max-height: 8px;
}

QLabel#entryTypeIconLabel[role="secondary"] {
    background-color: #9a9aa0;
}

QLabel#entryTypeIconLabel[role="muted"] {
    background-color: #6d6d73;
}

/* ---------- Exercise Card & Goal Card ----------
   Gleiche Card-Sprache wie QGroupBox (Surface/Border/Radius),
   aber ohne Titel-Notch, da der Name als eigenes Label geführt wird. */
QFrame#exerciseCard,
QFrame#goalCard {
    background-color: #19191c;
    border: 1px solid #29292d;
    border-radius: 6px;
}

QFrame#exerciseCard:hover,
QFrame#goalCard:hover {
    border: 1px solid #333338;
}

QLabel#exerciseCardNameLabel,
QLabel#goalCardTitleLabel {
    font-size: 13px;
    font-weight: 600;
}

QLabel#exerciseCardMetaHeaderLabel {
    font-size: 11px;
}

QLabel#exerciseCardCategoryTagLabel {
    background-color: #212124;
    color: #9a9aa0;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 11px;
}

QFrame#exerciseCardSeparator,
QFrame#goalCardSeparator {
    background-color: #29292d;
    max-height: 1px;
    border: none;
}

QPushButton#exerciseCardRunButton {
    font-weight: 600;
}

QLabel#goalCardDeadlineLabel {
    font-size: 11px;
}

QLabel#goalCardDescriptionLabel {
    font-size: 12px;
}

/* ---------- Scroll-Bereiche für Card-Grids ---------- */
QScrollArea#exerciseScrollArea,
QScrollArea#historyScrollArea,
QWidget#exerciseCardsWidget,
QWidget#historyEntriesWidget {
    background-color: transparent;
    border: none;
}

/* ---------- Splitter ---------- */
QSplitter::handle {
    background-color: #29292d;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

#roadmapInfoPanel {
    background-color: #19191c;
    border-left: 1px solid #29292d;
}

/* ---------- Scrollbars ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #333338;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #45454b;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #333338;
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: #45454b;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ---------- Statusbar ---------- */
QStatusBar {
    background-color: #0e0e10;
    color: #6d6d73;
    border-top: 1px solid #29292d;
}

/* ---------- Checkbox ---------- */
QCheckBox {
    color: #eaeaec;
    spacing: 8px;
}

QCheckBox {
    color: #eaeaec;
    spacing: 8px;
    background: transparent;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #333338;
    border-radius: 4px;
    background-color: #19191c;
}

QCheckBox::indicator:hover {
    border-color: #ff6f61;
}

QCheckBox::indicator:checked {
    background-color: #ff6f61;
    border-color: #ff6f61;
}

QListWidget#hobbyList {
    background: transparent;
    border: none;
}

QListWidget#hobbyList::item {
    background: transparent;
    border: none;
    padding: 8px 12px;
}

QListWidget#hobbyList::item:selected {
    background: transparent;
    border-left: 2px solid #ff6f61;
}

/* ---------- Ziel-Filter ---------- */

/* "Offen"/"Geschafft" (Ziele) und "Aktiv"/"Archiv" (Routinen) verhalten sich wie normale sekundäre
   Filter-Buttons und nicht wie die Hobby-Navigation. */
QToolButton#goalsFilterOpenButton,
QToolButton#goalsFilterDoneButton,
QToolButton#routinesFilterActiveButton,
QToolButton#routinesFilterArchiveButton {
    background-color: #19191c;
    color: #eaeaec;
    border: 1px solid #29292d;
    border-radius: 6px;
    padding: 7px 14px;
    font-size: 13px;
    font-weight: 500;
    border-bottom: 1px solid #29292d;
}

QToolButton#goalsFilterOpenButton:hover,
QToolButton#goalsFilterDoneButton:hover,
QToolButton#routinesFilterActiveButton:hover,
QToolButton#routinesFilterArchiveButton:hover {
    background-color: #212124;
    border-color: #333338;
}

QToolButton#goalsFilterOpenButton:pressed,
QToolButton#goalsFilterDoneButton:pressed,
QToolButton#routinesFilterActiveButton:pressed,
QToolButton#routinesFilterArchiveButton:pressed {
    background-color: #29292d;
}

QToolButton#goalsFilterOpenButton:checked,
QToolButton#goalsFilterDoneButton:checked,
QToolButton#routinesFilterActiveButton:checked,
QToolButton#routinesFilterArchiveButton:checked {
    background-color: #212124;
    color: #eaeaec;
    border: 1px solid #333338;
    border-bottom: 1px solid #333338;
}
/* ---------- Kopfbereich & Section-Titel ---------- */
QLabel#routineDialogTitleLabel {
    font-size: 16px;
    font-weight: 600;
    color: #eaeaec;
}

QLabel#routineDialogSubtitleLabel {
    font-size: 13px;
    color: #9a9aa0;
}

QLabel#routineExercisesLabel,
QLabel#selectedExercisesLabel {
    font-size: 13px;
    font-weight: 600;
    color: #eaeaec;
}

/* ---------- Suchfeld mit Icon (Icon ist Teil der SVG, 32px breit) ---------- */
QLineEdit#routineSearchLineEdit {
    padding-left: 32px;
    background-image: url(:/icons/search.svg);
    background-repeat: no-repeat;
    background-position: left center;
}

/* ---------- Empty State (Ausgewählte Übungen) ---------- */
QFrame#selectedExercisesEmptyPage {
    background-color: #19191c;
    border: 1px solid #29292d;
    border-radius: 6px;
}

QLabel#selectedExercisesEmptyTitleLabel {
    font-size: 13px;
    font-weight: 500;
    color: #9a9aa0;
}

QLabel#selectedExercisesEmptyHintLabel {
    font-size: 12px;
    color: #6d6d73;
}

/* ---------- Zeilen: Verfügbare Übungen (dynamisch) ---------- */
QLabel#availableExerciseNameLabel {
    font-size: 13px;
    font-weight: 500;
    color: #eaeaec;
}

QLabel#availableExerciseCategoryTagLabel {
    background-color: #212124;
    color: #9a9aa0;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 11px;
}

/* ---------- Zeilen: Ausgewählte Übungen (dynamisch) ---------- */
QFrame#selectedExerciseRow {
    background-color: transparent;
    border: none;
}

/* Drag-Handle: QLabel mit Text "☰" (Text steht in selected_exercise_row.ui) */
QLabel#selectedExerciseHandleLabel {
    background-color: transparent;
    color: #6d6d73;
    font-size: 14px;
}

QFrame#selectedExerciseRow:hover QLabel#selectedExerciseHandleLabel {
    color: #9a9aa0;
}

QLabel#selectedExerciseNameLabel {
    font-size: 13px;
    font-weight: 500;
    color: #eaeaec;
}

QLabel#selectedExerciseUnitLabel {
    font-size: 13px;
    color: #9a9aa0;
}

/* Ghost-Button, Destructive-Farbe nur bei Hover */
QPushButton#selectedExerciseRemoveButton {
    background-color: transparent;
    border: 1px solid transparent;
    color: #9a9aa0;
    padding: 4px 10px;
    font-size: 12px;
}

QPushButton#selectedExerciseRemoveButton:hover {
    background-color: rgba(229, 72, 77, 0.12);
    border-color: rgba(229, 72, 77, 0.35);
    color: #e5484d;
}

QPushButton#selectedExerciseRemoveButton:pressed {
    background-color: rgba(229, 72, 77, 0.20);
    border-color: rgba(229, 72, 77, 0.50);
}

/* ---------- QSpinBox (fehlt bisher in theme.qss) ---------- */
QSpinBox {
    background-color: #19191c;
    border: 1px solid #29292d;
    border-radius: 6px;
    padding: 6px 10px;
    color: #eaeaec;
    selection-background-color: #ff6f61;
    selection-color: #171012;
}

QSpinBox:hover {
    border-color: #333338;
}

QSpinBox:focus {
    border-color: #ff6f61;
}

QSpinBox:disabled {
    background-color: #17171a;
    color: #55555a;
}

QSpinBox::up-button, QSpinBox::down-button {
    width: 0px;
    border: none;
}

/* ---------- Footer: Primary-Action ---------- */
QPushButton#routineSaveButton {
    background-color: #ff6f61;
    color: #171012;
    border: 1px solid #ff6f61;
    font-weight: 600;
}

QPushButton#routineSaveButton:hover {
    background-color: #ff8677;
    border-color: #ff8677;
}

QPushButton#routineSaveButton:pressed {
    background-color: #e85c4e;
    border-color: #e85c4e;
}

QPushButton#routineSaveButton:disabled {
    background-color: #17171a;
    color: #55555a;
    border-color: #212124;
}
void MainWindow::loadRoutineCards()
{
    // Entfernt alle bisher erzeugten Cards.
    // Die Layouts selbst bleiben bestehen und können anschließend
    // wieder mit neuen Cards befüllt werden.
    auto clearLayout = [](QLayout *layout) {

        while (layout->count() > 0) {

            QLayoutItem *item =
                layout->takeAt(0);

            if (item->widget())
                item->widget()->deleteLater();

            delete item;
        }
    };

    clearLayout(ui->routineActiveCardsLayout);
    clearLayout(ui->routineArchiveCardsLayout);

    ui->routineActiveCardsLayout->setRowStretch(0, 0);
    ui->routineArchiveCardsLayout->setRowStretch(0, 0);

    if (currentHobbyId == 0)
        return;

    const QList<Routine> routines =
        RoutineRepository::getForHobby(currentHobbyId);

    constexpr int columnCount = 3;

    int activeCount = 0;
    int archiveCount = 0;

    // Erstellt eine Routine-Card.
    //
    // Die Card verwendet bewusst dieselbe grundlegende Struktur
    // wie die bestehenden Exercise- und Goal-Cards.
    auto buildCard =
        [this](const Routine &routine) -> QFrame * {

        auto *card =
            new QFrame();

        card->setObjectName("routineCard");
        card->setFrameShape(QFrame::StyledPanel);

        // Eine Routine-Card ist bewusst doppelt so hoch wie
        // eine normale Exercise-/Goal-Card.
        //
        // 176 px normale Card-Höhe
        // + 12 px Abstand
        // + 176 px normale Card-Höhe
        //
        // = 364 px
        card->setFixedHeight(364);

        card->setSizePolicy(
            QSizePolicy::Expanding,
            QSizePolicy::Fixed
            );

        card->setCursor(
            Qt::PointingHandCursor
            );

        auto *cardLayout =
            new QVBoxLayout(card);

        // Gleiche Innenabstände wie bei den anderen Cards.
        cardLayout->setContentsMargins(
            12,
            12,
            12,
            12
            );

        cardLayout->setSpacing(4);

        // ── Titel + Stern ────────────────────────────────────────────────

        auto *topRow =
            new QHBoxLayout();

        topRow->setSpacing(8);

        auto *nameLabel =
            new QLabel(
                routine.name,
                card
                );

        nameLabel->setObjectName(
            "routineCardNameLabel"
            );

        nameLabel->setWordWrap(true);

        topRow->addWidget(
            nameLabel,
            1
            );

        // Der Stern wird später mit derselben Dashboard-Logik
        // wie bei den Goal-Cards verbunden.
        auto *favoriteButton =
            new QToolButton(card);

        favoriteButton->setObjectName(
            "routineFavoriteButton"
            );

        favoriteButton->setFixedSize(
            24,
            24
            );

        favoriteButton->setIconSize(
            QSize(16, 16)
            );

        favoriteButton->setAutoRaise(true);
        favoriteButton->setCursor(
            Qt::PointingHandCursor
            );

        favoriteButton->setIcon(
            QIcon(
                ":/icons/star-outline.svg"
                )
            );

        favoriteButton->setToolTip(
            "Zum Dashboard hinzufügen"
            );

        topRow->addWidget(
            favoriteButton,
            0,
            Qt::AlignTop
            );

        cardLayout->addLayout(
            topRow
            );

        // ── Beschreibung ─────────────────────────────────────────────────

        auto *descriptionLabel =
            new QLabel(
                routine.description,
                card
                );

        descriptionLabel->setObjectName(
            "routineCardDescriptionLabel"
            );

        descriptionLabel->setProperty(
            "role",
            "secondary"
            );

        descriptionLabel->setWordWrap(true);

        descriptionLabel->setAlignment(
            Qt::AlignLeft |
            Qt::AlignTop
            );

        // Die Beschreibung bekommt einen begrenzten Bereich,
        // damit die darunterliegenden Informationen nicht verschoben werden.
        descriptionLabel->setMaximumHeight(
            42
            );

        cardLayout->addWidget(
            descriptionLabel
            );

        // ── Übungen ──────────────────────────────────────────────────────

        auto *exercisesHeader =
            new QLabel(
                "Übungen",
                card
                );

        exercisesHeader->setObjectName(
            "routineCardMetaHeaderLabel"
            );

        exercisesHeader->setProperty(
            "role",
            "muted"
            );

        cardLayout->addWidget(
            exercisesHeader
            );

        const QList<RoutineStep> steps =
            RoutineRepository::getSteps(
                routine.id
                );

        // Für die Anzeige werden die Übungen über das bestehende
        // ExerciseRepository geladen.
        //
        // Die Routine speichert nur die exerciseId.
        QHash<int, QString> exerciseNames;

        const QList<Exercise> exercises =
            ExerciseRepository::getForHobby(
                currentHobbyId,
                true
                );

        for (const Exercise &exercise : exercises) {

            exerciseNames.insert(
                exercise.id,
                exercise.name
                );
        }

        // Wir zeigen maximal vier Übungen direkt auf der Card.
        // Die vollständige Liste bleibt in der Routine selbst erhalten.
        constexpr int visibleExerciseCount = 4;

        int shownCount = 0;

        for (const RoutineStep &step : steps) {

            if (shownCount >= visibleExerciseCount)
                break;

            auto *exerciseRow =
                new QHBoxLayout();

            exerciseRow->setSpacing(8);

            auto *exerciseLabel =
                new QLabel(
                    exerciseNames.value(
                        step.exerciseId,
                        "Unbekannte Übung"
                        ),
                    card
                    );

            exerciseLabel->setObjectName(
                "routineCardExerciseLabel"
                );

            exerciseRow->addWidget(
                exerciseLabel
                );

            exerciseRow->addStretch();

            const int minutes =
                step.durationSeconds / 60;

            auto *durationLabel =
                new QLabel(
                    QString("%1 min")
                        .arg(minutes),
                    card
                    );

            durationLabel->setObjectName(
                "routineCardDurationLabel"
                );

            durationLabel->setProperty(
                "role",
                "secondary"
                );

            exerciseRow->addWidget(
                durationLabel
                );

            cardLayout->addLayout(
                exerciseRow
                );

            ++shownCount;
        }

        if (steps.size() > visibleExerciseCount) {

            const int remaining =
                steps.size() -
                visibleExerciseCount;

            auto *moreLabel =
                new QLabel(
                    QString("+ %1 weitere")
                        .arg(remaining),
                    card
                    );

            moreLabel->setObjectName(
                "routineCardMoreLabel"
                );

            moreLabel->setProperty(
                "role",
                "secondary"
                );

            cardLayout->addWidget(
                moreLabel
                );
        }

        // ── Letzte Ausführung ────────────────────────────────────────────

        auto *lastHeader =
            new QLabel(
                "Letzte Ausführung",
                card
                );

        lastHeader->setObjectName(
            "routineCardMetaHeaderLabel"
            );

        lastHeader->setProperty(
            "role",
            "muted"
            );

        cardLayout->addWidget(
            lastHeader
            );

        const QList<RoutineLog> logs =
            RoutineRepository::getLogs(
                routine.id
                );

        auto *lastExecutionRow =
            new QHBoxLayout();

        if (!logs.isEmpty()) {

            const QDateTime performedAt =
                QDateTime::fromString(
                    logs.first().performedAt,
                    "yyyy-MM-dd HH:mm:ss"
                    ).toLocalTime();

            lastExecutionRow->addWidget(
                new QLabel(
                    performedAt.toString(
                        "dd.MM.yyyy"
                        ),
                    card
                    )
                );

            lastExecutionRow->addStretch();

        } else {

            lastExecutionRow->addWidget(
                new QLabel(
                    "–",
                    card
                    )
                );

            lastExecutionRow->addStretch();
        }

        cardLayout->addLayout(
            lastExecutionRow
            );

        // Der Stretch sorgt dafür, dass der untere Bereich
        // immer am unteren Kartenrand bleibt.
        cardLayout->addStretch();

        // ── Trennlinie ────────────────────────────────────────────────────

        auto *separator =
            new QFrame(card);

        separator->setObjectName(
            "routineCardSeparator"
            );

        separator->setFrameShape(
            QFrame::HLine
            );

        cardLayout->addWidget(
            separator
            );

        // ── Buttons ──────────────────────────────────────────────────────

        auto *buttonRow =
            new QHBoxLayout();

        auto *editButton =
            new QPushButton(
                "Bearbeiten",
                card
                );

        auto *executeButton =
            new QPushButton(
                "Ausführen",
                card
                );

        executeButton->setObjectName(
            "routineCardRunButton"
            );

        buttonRow->addWidget(
            editButton
            );

        buttonRow->addWidget(
            executeButton
            );

        cardLayout->addLayout(
            buttonRow
            );

        // ── Button-Aktionen ──────────────────────────────────────────────

        connect(
            editButton,
            &QPushButton::clicked,
            this,
            [this, routine]() {

                // Die Bearbeiten-Funktion wird später ergänzt.
                Q_UNUSED(routine);
            }
            );

        connect(
            executeButton,
            &QPushButton::clicked,
            this,
            [this, routine]() {

                // Die Ausführen-Funktion wird später ergänzt.
                Q_UNUSED(routine);
            }
            );

        // ── Archivieren / Aktivieren ─────────────────────────────────────
        //
        // Das geschieht nicht über einen zusätzlichen Button.
        // Die Funktion wird später über die Detail-/Bearbeitenansicht
        // beziehungsweise die Card-Aktion angebunden.

        return card;
    };

    // ── Routinen auf die beiden Grids verteilen ───────────────────────────

    for (const Routine &routine : routines) {

        if (routine.archived) {

            QFrame *card =
                buildCard(routine);

            ui->routineArchiveCardsLayout->addWidget(
                card,
                archiveCount / columnCount,
                archiveCount % columnCount
                );

            ++archiveCount;

        } else {

            QFrame *card =
                buildCard(routine);

            ui->routineActiveCardsLayout->addWidget(
                card,
                activeCount / columnCount,
                activeCount % columnCount
                );

            ++activeCount;
        }
    }

    // Die Cards bleiben am oberen Rand des jeweiligen Bereichs.
    const int activeRowCount =
        (activeCount + columnCount - 1) /
        columnCount;

    const int archiveRowCount =
        (archiveCount + columnCount - 1) /
        columnCount;

    ui->routineActiveCardsLayout->setRowStretch(
        activeRowCount,
        1
        );

    ui->routineArchiveCardsLayout->setRowStretch(
        archiveRowCount,
        1
        );
}