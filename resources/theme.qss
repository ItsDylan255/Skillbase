/* ============================================================
   Skillbase – Linear-inspired dark theme
   Anwenden via QApplication::setStyleSheet(...) in main.cpp,
   damit auch Dialoge ohne eigenes Root-Stylesheet
   (z.B. exercise_execution_dialog) automatisch gestylt sind.
   ============================================================
   Farbpalette
   --bg            #121214   Haupt-Hintergrund
   --bg-sidebar    #0e0e10   Sidebar-Hintergrund (dunkler)
   --surface       #19191c   Cards / Inputs / erhöhte Flächen
   --surface-hover #212124   Hover-Fläche
   --border        #29292d   Standard-Border
   --border-light  #333338   Etwas hellere Border (Hover/Focus-Trenner)
   --text-primary  #eaeaec   Haupttext
   --text-secondary#9a9aa0   Sekundärtext
   --text-muted    #6d6d73   Metadaten / Platzhalter
   --accent        #ff6f61   Skillbase-Orange
   --accent-hover  #ff8677
   --accent-pressed#e85c4e
   --danger        #e5484d   Destruktive Aktionen (nur Text)
   --success       #3fb950   Erfolg / abgeschlossen (zurückhaltend einsetzen)
   --warning       #d29922   Warnung / Achtung
   --info          #58a6ff   Neutraler Hinweis
   ============================================================
   Qt Style Sheets kennen keine CSS-Variablen - die Werte oben
   sind die Referenz, die tatsächlichen Farbwerte werden unten
   direkt in den Selektoren wiederholt.
   ============================================================ */

/* ---------- Basis ---------- */
QMainWindow, QDialog, QWidget {
    background-color: #121214;
    color: #eaeaec;
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 13px;
}
QToolButton#goalCurrentButton {
    padding: 0;
    border: none;
    border-bottom: none;
    background: transparent;
    border-radius: 6px;
}

QToolButton#goalCurrentButton:hover {
    background-color: #212124;
}

QToolButton#routineFavoriteButton {
    padding: 0;
    border: none;
    border-bottom: none;
    background: transparent;
    border-radius: 6px;
}

QToolButton#routineFavoriteButton:hover {
    background-color: #212124;
}

/* Labels sollen standardmäßig keine eigene Fläche zeichnen.
   Dadurch bleibt innerhalb von Cards deren Surface sichtbar. */
QLabel {
    background-color: transparent;
}

QWidget:disabled {
    color: #55555a;
}

QToolTip {
    background-color: #19191c;
    color: #eaeaec;
    border: 1px solid #29292d;
    padding: 4px 8px;
    border-radius: 4px;
}

/* ---------- Sidebar ---------- */
#sidebar {
    background-color: #0e0e10;
}

QFrame#line {
    background-color: #29292d;
    max-width: 1px;
    min-width: 1px;
    border: none;
}

QLabel#sidebarTitleLabel {
    font-size: 16px;
    font-weight: 600;
    color: #eaeaec;
    padding: 8px 4px 16px 4px;
}

QLabel#sidebarHobbySectionLabel {
    font-size: 11px;
    font-weight: 600;
    color: #6d6d73;
    padding: 12px 4px 4px 4px;
}

#sidebar QPushButton {
    background-color: transparent;
    border: none;
    border-left: 2px solid transparent;
    border-radius: 0px;
    color: #9a9aa0;
    text-align: left;
    padding: 8px 10px 8px 8px;
    font-size: 13px;
    font-weight: 500;
}

#sidebar QPushButton:hover {
    background-color: #212124;
    color: #eaeaec;
}

#sidebar QPushButton:pressed {
    background-color: #29292d;
}

/* Aktiver Menüpunkt: dezenter Accent-Indikator am linken Rand statt
   einer vollflächigen Farbfläche (siehe ui-guidelines.md, "Navigation"). */
#sidebar QPushButton:checked {
    background-color: transparent;
    border-left: 2px solid #ff6f61;
    color: #eaeaec;
    font-weight: 600;
}

#sidebar QListWidget {
    background-color: transparent;
    border: none;
}

/* ---------- Seiten-/Section-Titel ---------- */
QLabel#dashboardTitleLabel,
QLabel#hobbyLabel,
QLabel#settingsTitleLabel,
QLabel#statisticsTitleLabel {
    font-size: 22px;
    font-weight: 600;
    color: #eaeaec;
    padding-bottom: 4px;
}

/* Tab-Section-Titel innerhalb einer Hobby-Seite (Übungen/Ziele/Verlauf/
   Timeline/Roadmap) - bewusst eine Stufe kleiner als die Seiten-Titel
   oben und einheitlich für alle Tabs, damit z. B. "Ziele" und "Verlauf"
   an derselben Stelle/Größe wie "Übungen" stehen. */
QLabel#hobbyDashboardHeaderLabel,
QLabel#exercisesHeaderLabel,
QLabel#goalsHeaderLabel,
QLabel#routinesHeaderLabel,
QLabel#historyHeaderLabel,
QLabel#timelineHeaderLabel,
QLabel#roadmapHeaderLabel,
QLabel#roadmapInfoTitle,
QLabel#exerciseDetailNameLabel {
    font-size: 16px;
    font-weight: 600;
    color: #eaeaec;
}

/* "titleLabel" ist als Objektname doppelt vergeben: im
   Execution-Dialog die große Dialog-Überschrift ("Übung ausführen"),
   im GoalDialog dagegen nur die Feldbeschriftung von "Titel *".
   Deshalb hier bewusst auf den Execution-Dialog verankert (per
   Root-ObjectName-Selektor), statt global über QLabel#titleLabel zu
   gehen - siehe namensvorschlaege.md, Punkt 1. */
#ExerciseExecutionDialog QLabel#titleLabel {
    font-size: 16px;
    font-weight: 600;
    color: #eaeaec;
}

/* Sekundäre/Meta-Header innerhalb des Roadmap-Infopanels und des Execution-Dialogs,
   sowie die kleinen Section-Header auf der Übersicht und dem Hobby-Dashboard
   ("AKTUELLE PHASE", "ROUTINEN", "NOTIZ", "STATISTIK" usw.). */
QLabel#roadmapInfoStatusHeader,
QLabel#roadmapInfoDescriptionHeader,
QLabel#roadmapInfoParentHeader,
QLabel#exerciseLabel,
QLabel#goalTitleLabel,
QLabel#valueTitleLabel,
QLabel#durationTitleLabel,
QLabel#exerciseDetailStartHeaderLabel,
QLabel#exerciseDetailCurrentHeaderLabel,
QLabel#exerciseDetailGoalHeaderLabel,
QLabel#exerciseDetailLastPerformedHeaderLabel,
QLabel#exerciseDetailExecutionCountHeaderLabel,
QLabel#exerciseDetailTotalTimeHeaderLabel,
QLabel#exerciseDetailAvgDurationHeaderLabel,
QLabel#exerciseDetailFirstPerformedHeaderLabel,
QLabel#exerciseDetailBestValueHeaderLabel,
QLabel#exerciseDetailAvgValueHeaderLabel,
QLabel#exerciseDetailProgressSinceStartHeaderLabel,
QLabel#todaySectionLabel,
QLabel#goalsSectionLabel,
QLabel#progressSectionLabel,
QLabel#recentActivitySectionLabel,
QLabel#hobbyPhaseSectionLabel,
QLabel#hobbyGoalSectionLabel,
QLabel#hobbyRoutinesSectionLabel,
QLabel#hobbyNoteSectionLabel,
QLabel#hobbyStatsSectionLabel {
    font-size: 11px;
    font-weight: 600;
    color: #6d6d73;
    padding-top: 8px;
}

/* Wertanzeigen im Execution-Dialog, in der Übungs-Detailansicht sowie
   die aktuelle Phase / das aktuelle Ziel im Hobby-Dashboard. */
QLabel#exerciseNameLabel,
QLabel#exerciseDetailStartValueLabel,
QLabel#exerciseDetailCurrentValueLabel,
QLabel#exerciseDetailGoalValueLabel,
QLabel#exerciseDetailLastPerformedLabel,
QLabel#exerciseDetailExecutionCountLabel,
QLabel#exerciseDetailTotalTimeLabel,
QLabel#exerciseDetailAvgDurationLabel,
QLabel#exerciseDetailFirstPerformedLabel,
QLabel#exerciseDetailBestValueLabel,
QLabel#exerciseDetailAvgValueLabel,
QLabel#exerciseDetailProgressSinceStartLabel,
QLabel#hobbyPhaseNameLabel,
QLabel#hobbyGoalNameLabel {
    font-size: 14px;
    font-weight: 500;
    color: #eaeaec;
}

/* "goalLabel" ist als Objektname doppelt vergeben: im Execution-Dialog
   die dynamische Wertanzeige (Ziel + Einheit), im ExerciseDialog dagegen
   nur die Feldbeschriftung von "Ziel" (soll wie nameLabel/valueLabel/
   unitLabel aussehen, siehe namensvorschlaege.md, Punkt 2). */
#ExerciseExecutionDialog QLabel#goalLabel {
    font-size: 14px;
    font-weight: 500;
    color: #eaeaec;
}

QLabel#unitLabel {
    color: #9a9aa0;
}

/* Gedämpfte Body-/Hinweistexte, inkl. Untertitel der Übersicht/des
   Hobby-Dashboards und der Countdown-/Deadline-Zeilen. */
QLabel#dashboardSubtitleLabel,
QLabel#hobbyDashboardSubtitleLabel,
QLabel#hobbyPhaseCountdownLabel,
QLabel#hobbyGoalDeadlineLabel,
QLabel#hobbyRoutinesEmptyLabel,
QLabel#todayLabel,
QLabel#goalsSummaryLabel,
QLabel#progressSummaryLabel,
QLabel#hobbyTodayLabel,
QLabel#hobbyGoalsSummaryLabel,
QLabel#hobbyProgressSummaryLabel,
QLabel#historyEmptyStateLabel,
QLabel#timelineEmptyLabel,
QLabel#roadmapInfoNameLabel,
QLabel#roadmapInfoStatusLabel,
QLabel#roadmapInfoDescriptionLabel,
QLabel#roadmapInfoParentLabel,
QLabel#exerciseDetailDescriptionLabel,
QLabel#exerciseDetailPercentLabel {
    color: #9a9aa0;
    font-size: 13px;
}

/* Große Statistik-Werte im Hobby-Dashboard ("126", "34 h 20 min", ...) -
   dürfen laut ui-guidelines.md stärker hervorgehoben werden. */
QLabel#hobbyStatExercisesValueLabel,
QLabel#hobbyStatTimeValueLabel,
QLabel#hobbyStatSessionsValueLabel,
QLabel#hobbyStatGoalsValueLabel {
    font-size: 20px;
    font-weight: 700;
    color: #eaeaec;
}

QLabel#hobbyStatExercisesCaptionLabel,
QLabel#hobbyStatTimeCaptionLabel,
QLabel#hobbyStatSessionsCaptionLabel,
QLabel#hobbyStatGoalsCaptionLabel {
    font-size: 12px;
    color: #9a9aa0;
}

/* ---------- Übungs-Detailansicht ---------- */

/* Kategorie-Tag im Kopfbereich der Detailansicht (gleiche Optik wie
   die Kategorie-Tags auf den Übungskarten). */
QLabel#exerciseDetailCategoryTagLabel {
    background-color: #2a2a2a;
    color: #aaaaaa;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 11px;
    max-width: 200px;
}

/* Kleiner, zurückhaltender Link-artiger Button zum Bearbeiten des
   Startwerts - bewusst leichter als ein normaler Secondary-Button. */
QPushButton#exerciseDetailEditStartValueButton {
    background-color: transparent;
    border: none;
    color: #9a9aa0;
    font-size: 11px;
    font-weight: 500;
    padding: 2px 6px;
}
/* Inline-Bearbeitung des Startwerts: ersetzt das Label während der Bearbeitung */
QLineEdit#exerciseDetailStartValueEdit {
    background-color: #19191c;
    color: #eaeaec;
    border: 1px solid #ff6f61;
    border-radius: 4px;
    padding: 1px 6px;
    font-size: 14px;
    font-weight: 500;
}

QPushButton#exerciseDetailEditStartValueButton:hover {
    color: #eaeaec;
    text-decoration: underline;
}

QPushButton#exerciseDetailEditStartValueButton:pressed {
    color: #ff6f61;
}

/* Fortschrittsbalken in der Übungs-Detailansicht */
QProgressBar#exerciseDetailProgressBar {
    background-color: #19191c;
    border: 1px solid #29292d;
    border-radius: 4px;
    height: 8px;
    max-height: 8px;
}

QProgressBar#exerciseDetailProgressBar::chunk {
    background-color: #ff6f61;
    border-radius: 4px;
}

QFrame#roadmapInfoSeparator,
QFrame#dashboardDivider1,
QFrame#dashboardDivider2,
QFrame#dashboardDivider3,
QFrame#hobbyDashboardDivider1,
QFrame#hobbyDashboardDivider2,
QFrame#hobbyDashboardDivider3,
QFrame#hobbyDashboardDivider4 {
    background-color: #29292d;
    max-height: 1px;
    border: none;
}

/* Timeline-Seite: Trennlinie über die volle Seitenbreite (ohne 12px-Margins) */
QFrame#timelineSeparator {
    background-color: #29292d;
    border: none;
    max-height: 1px;
}

/* Aktuelle Phase / Aktuelles Ziel im Hobby-Dashboard: untereinander
   angeordnete, klickbare Cards - gleiche Card-Sprache wie exerciseCard/
   goalCard (Surface, dünne Border, 6px Radius), Hover nur über die Border. */
QFrame#hobbyPhaseSection,
QFrame#hobbyGoalSection {
    background-color: #19191c;
    border: 1px solid #29292d;
    border-radius: 6px;
}

QFrame#hobbyPhaseSection:hover,
QFrame#hobbyGoalSection:hover {
    background-color: #1c1c1f;
    border: 1px solid #333338;
}

/* Fortschrittsbalken der aktuellen Phase im Hobby-Dashboard - gleiche
   Optik wie der Fortschrittsbalken in der Übungs-Detailansicht. */
QProgressBar#hobbyPhaseProgressBar {
    background-color: #121214;
    border: 1px solid #29292d;
    border-radius: 4px;
    height: 8px;
    max-height: 8px;
}

QProgressBar#hobbyPhaseProgressBar::chunk {
    background-color: #ff6f61;
    border-radius: 4px;
}

/* "+ Routine hinzufügen" im Empty-State des Dashboards ist eine
   sekundäre Aktion, kein Primary-Button (davon gibt es max. einen
   pro Kontext - das ist bereits addRoutineButton auf der Routinen-Seite). */
QPushButton#hobbyRoutinesAddButton {
    padding: 6px 12px;
    font-size: 12px;
}

/* ---------- Cards (QGroupBox) ---------- */
QGroupBox {
    background-color: #19191c;
    border: 1px solid #29292d;
    border-radius: 6px;
    margin-top: 14px;
    padding: 16px 12px 12px 12px;
    font-size: 13px;
    font-weight: 600;
    color: #eaeaec;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    top: 2px;
    padding: 0 4px;
    color: #eaeaec;
    font-size: 13px;
    font-weight: 600;
}

/* ---------- Tabs (QToolButton als Hobby-Navigation & View-Toggle) ---------- */
QToolButton {
    border: none;
    background: transparent;
    padding: 8px 14px;
    color: #9a9aa0;
    font-size: 13px;
    font-weight: 500;
    border-bottom: 2px solid transparent;
}

QToolButton:hover {
    color: #eaeaec;
}

QToolButton:checked {
    color: #eaeaec;
    border-bottom: 2px solid #ff6f61;
}

/* Hobby-Navigation: durchgehende Trennlinie unter allen Tabs.
   Jeder Tab zeichnet unten immer 2px - grau, wenn inaktiv, Accent, wenn
   aktiv. Da das Layout (hobbyNavigation) spacing 0 hat und ohne seitliche
   Margins über die volle Breite läuft, ergibt das eine einzige Linie, bei
   der die rote Markierung exakt auf gleicher Höhe und Dicke sitzt. */
QToolButton#dashboardTab,
QToolButton#routinesTab,
QToolButton#exercisesTab,
QToolButton#goalsTab,
QToolButton#roadmapTab,
QToolButton#historyTab {
    border-bottom: 2px solid #29292d;
}

QToolButton#dashboardTab:checked,
QToolButton#routinesTab:checked,
QToolButton#exercisesTab:checked,
QToolButton#goalsTab:checked,
QToolButton#roadmapTab:checked,
QToolButton#historyTab:checked {
    border-bottom: 2px solid #ff6f61;
}

/* ---------- Buttons ---------- */
QPushButton {
    background-color: #19191c;
    color: #eaeaec;
    border: 1px solid #29292d;
    border-radius: 6px;
    padding: 7px 14px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #212124;
    border-color: #333338;
}

QPushButton:pressed {
    background-color: #29292d;
}

QPushButton:disabled {
    color: #55555a;
    border-color: #212124;
    background-color: #17171a;
}

QPushButton:focus {
    border-color: #ff6f61;
    outline: none;
}

/* Die Start/Pause/Stopp-Buttons bekommen keinen Windows-Fokusrahmen. */
QPushButton#routineExecutionStartPauseButton:focus,
QPushButton#routineExecutionStopButton:focus,
QPushButton#exerciseExecutionStartPauseButton:focus,
QPushButton#exerciseExecutionStopButton:focus {
    outline: none;
    border: 1px solid #ff6f61;
}

/* Primary-Buttons: alle "+ hinzufügen"-Aktionen */
QPushButton#addExerciseButton,
QPushButton#addRoutineButton,
QPushButton#addGoalButton,
QPushButton#addRoadmapGoalButton,
QPushButton#addTimelinePhaseButton,
QPushButton#addButton,
QPushButton#routineExecutionStartPauseButton,
QPushButton#exerciseExecutionStartPauseButton {
    background-color: #ff6f61;
    color: #171012;
    border: 1px solid #ff6f61;
    font-weight: 600;
}

QPushButton#addExerciseButton:hover,
QPushButton#addRoutineButton:hover,
QPushButton#addGoalButton:hover,
QPushButton#addRoadmapGoalButton:hover,
QPushButton#addTimelinePhaseButton:hover,
QPushButton#addButton:hover,
QPushButton#routineExecutionStartPauseButton:hover,
QPushButton#exerciseExecutionStartPauseButton:hover {
    background-color: #ff8677;
    border-color: #ff8677;
}

QPushButton#addExerciseButton:pressed,
QPushButton#addRoutineButton:pressed,
QPushButton#addGoalButton:pressed,
QPushButton#addRoadmapGoalButton:pressed,
QPushButton#addTimelinePhaseButton:pressed,
QPushButton#addButton:pressed,
QPushButton#routineExecutionStartPauseButton:pressed,
QPushButton#exerciseExecutionStartPauseButton:pressed {
    background-color: #e85c4e;
    border-color: #e85c4e;
}


/* Destruktive Aktionen: dezent über Textfarbe, keine Fläche */
QPushButton#deleteButton,
QPushButton#deletePhaseButton {
    color: #e5484d;
    border-color: #29292d;
    background-color: transparent;
}

QPushButton#deleteButton:hover,
QPushButton#deletePhaseButton:hover {
    background-color: rgba(229, 72, 77, 0.12);
    border-color: rgba(229, 72, 77, 0.35);
}

QPushButton#deleteButton:pressed,
QPushButton#deletePhaseButton:pressed {
    background-color: rgba(229, 72, 77, 0.20);
    border-color: rgba(229, 72, 77, 0.50);
}

QPushButton#deleteButton:disabled,
QPushButton#deletePhaseButton:disabled {
    color: #55555a;
    border-color: #212124;
    background-color: transparent;
}

/* QDialogButtonBox Buttons (Save/Cancel) */
QDialogButtonBox QPushButton {
    min-width: 84px;
}

/* Die primäre Aktion eines Dialogs (Speichern/Erstellen) wird als
   Default-Button gesetzt und erhält dieselbe Primary-Button-Farbe
   wie "+ hinzufügen"-Aktionen (siehe oben). */
QDialogButtonBox QPushButton[default="true"] {
    background-color: #ff6f61;
    color: #171012;
    border: 1px solid #ff6f61;
    font-weight: 600;
}

QDialogButtonBox QPushButton[default="true"]:hover {
    background-color: #ff8677;
    border-color: #ff8677;
}

QDialogButtonBox QPushButton[default="true"]:pressed {
    background-color: #e85c4e;
    border-color: #e85c4e;
}

QDialogButtonBox QPushButton[default="true"]:disabled {
    background-color: #17171a;
    color: #55555a;
    border-color: #212124;
}

/* ---------- Inputs ---------- */
QLineEdit, QPlainTextEdit, QTextEdit {
    background-color: #19191c;
    border: 1px solid #29292d;
    border-radius: 6px;
    padding: 7px 10px;
    color: #eaeaec;
    selection-background-color: #ff6f61;
    selection-color: #171012;
}

QLineEdit:hover, QPlainTextEdit:hover, QTextEdit:hover {
    border-color: #333338;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus {
    border-color: #ff6f61;
}

QLineEdit:disabled, QPlainTextEdit:disabled {
    background-color: #17171a;
    color: #55555a;
}

/* ---------- Routine-Dialog: ausgewählte Übung (Tag im Suchfeld) ----------
   Das Tag ist ein Label, das im Code (RoutineDialog) als Kind über das
   Suchfeld gelegt wird. Solange es sichtbar ist, bekommt das Suchfeld die
   Property tagged="true" und macht seinen Text unsichtbar, damit er nicht
   unter dem Tag durchscheint. Das ✕ ist der normale Clear-Button des Felds. */
QLineEdit#routineExerciseSearchLineEdit[tagged="true"] {
    color: transparent;
}

QLabel#routineSelectedChipLabel {
    background-color: #29292d;
    color: #eaeaec;
    font-size: 13px;
    font-weight: 500;
    padding: 0px 10px;
    border-radius: 4px;
}

QComboBox {
    background-color: #19191c;
    border: 1px solid #29292d;
    border-radius: 6px;
    padding: 6px 10px;
    color: #eaeaec;
}

QComboBox:hover {
    border-color: #333338;
}

QComboBox:focus {
    border-color: #ff6f61;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    border: none;
    width: 24px;
}

/* Eigener Pfeil (SVG, Text Secondary #9a9aa0): Sobald ::drop-down gestylt
   wird, zeichnet Qt den nativen Pfeil nicht mehr - er muss explizit
   gesetzt werden. */
QComboBox::down-arrow {
    image: url(:/icons/chevron-down.svg);
    width: 12px;
    height: 12px;
}

QComboBox::down-arrow:disabled {
    image: url(:/icons/chevron-down-disabled.svg);
}

QComboBox QAbstractItemView {
    background-color: #19191c;
    border: 1px solid #29292d;
    border-radius: 6px;
    color: #eaeaec;
    selection-background-color: #29292d;
    selection-color: #eaeaec;
    outline: none;
}

QDateEdit {
    background-color: #19191c;
    border: 1px solid #29292d;
    border-radius: 6px;
    padding: 6px 10px;
    color: #eaeaec;
    selection-background-color: #ff6f61;
    selection-color: #171012;
}

QDateEdit:hover {
    border-color: #333338;
}

QDateEdit:focus {
    border-color: #ff6f61;
}

QDateEdit:disabled {
    background-color: #17171a;
    color: #55555a;
}

QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    border: none;
    width: 24px;
}

QDateEdit::down-arrow {
    image: url(:/icons/chevron-down.svg);
    width: 12px;
    height: 12px;
}

QDateEdit::down-arrow:disabled {
    image: url(:/icons/chevron-down-disabled.svg);
}

/* ---------- Listen / Trees ---------- */
QListWidget, QTreeWidget {
    background-color: #19191c;
    border: 1px solid #29292d;
    border-radius: 6px;
    padding: 4px;
    color: #eaeaec;
    outline: none;
}

QListWidget::item, QTreeWidget::item {
    padding: 6px 8px;
    border-radius: 4px;
}

QListWidget::item:hover, QTreeWidget::item:hover {
    background-color: #212124;
}

QListWidget::item:selected, QTreeWidget::item:selected {
    background-color: rgba(255, 111, 97, 0.15);
    color: #eaeaec;
}

QTreeWidget {
    show-decoration-selected: 1;
}

QHeaderView::section {
    background-color: #19191c;
    color: #9a9aa0;
    padding: 6px 8px;
    border: none;
    border-bottom: 1px solid #29292d;
    font-weight: 600;
}

/* ---------- Verlauf: History Entry Row ---------- */
HistoryEntryWidget {
    background-color: transparent;
    border-radius: 6px;
}

HistoryEntryWidget:hover {
    background-color: #212124;
}

/* Rollenbasierte Textfarben (dynamic property "role" auf QLabel, siehe HistoryEntryWidget) */
QLabel[role="secondary"] {
    color: #9a9aa0;
}

QLabel[role="muted"] {
    color: #6d6d73;
}

QLabel[role="accent"] {
    color: #ff6f61;
}

QLabel[role="success"] {
    color: #3fb950;
}

QLabel[role="warning"] {
    color: #d29922;
}

QLabel[role="info"] {
    color: #58a6ff;
}

/* ---------- Verlauf: Datums-Trenner ---------- */
HistoryDateHeaderWidget {
    background-color: transparent;
    border-bottom: 1px solid #29292d;
}

HistoryDateHeaderWidget QLabel#dateLabel {
    font-size: 11px;
    font-weight: 600;
    color: #6d6d73;
}

/* Eintragstitel im Verlauf (fett, wie jeder andere Primary-Body-Text) */
QLabel#entryTitleLabel {
    font-size: 13px;
    font-weight: 600;
    color: #eaeaec;
}

/* "Zeitraum"-Zwischenüberschrift im TimelinePhaseDialog - gleiche
   Optik wie eine Feld-Gruppenüberschrift, etwas stärker als die
   einfachen Feldbeschriftungen (Name/Beschreibung) darüber. */
QLabel#periodLabel {
    font-size: 13px;
    font-weight: 600;
    color: #eaeaec;
}

/* Status-Punkt vor jedem Verlaufseintrag: kleiner, echter Kreis statt
   Font-Glyph ("●"), damit Größe/Position pixelgenau und rendererunabhängig
   sind. Farbe kommt weiterhin über die role-Property (aktuell "accent"). */
QLabel#entryTypeIconLabel {
    background-color: #ff6f61;
    border-radius: 4px;
    min-width: 8px;
    max-width: 8px;
    min-height: 8px;
    max-height: 8px;
}

QLabel#entryTypeIconLabel[role="secondary"] {
    background-color: #9a9aa0;
}

QLabel#entryTypeIconLabel[role="muted"] {
    background-color: #6d6d73;
}

/* ---------- Exercise Card & Goal Card ----------
   Gleiche Card-Sprache wie QGroupBox (Surface/Border/Radius),
   aber ohne Titel-Notch, da der Name als eigenes Label geführt wird. */
QFrame#exerciseCard,
QFrame#goalCard {
    background-color: #19191c;
    border: 1px solid #29292d;
    border-radius: 6px;
}
QLabel#routineCardNameLabel {
    font-size: 13px;
    font-weight: 700;
}

QFrame#exerciseCard:hover,
QFrame#goalCard:hover {
    border: 1px solid #333338;
}

QLabel#exerciseCardNameLabel,
QLabel#goalCardTitleLabel,
QLabel#routineCardNameLabel {
    font-size: 13px;
    font-weight: 700;
}

QLabel#exerciseCardMetaHeaderLabel {
    font-size: 11px;
}

QLabel#historyCardNameLabel {
    font-size: 13px;
    font-weight: 700;
}

QLabel#exerciseCardCategoryTagLabel {
    background-color: #212124;
    color: #9a9aa0;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 11px;
}

QFrame#exerciseCardSeparator,
QFrame#goalCardSeparator {
    background-color: #29292d;
    max-height: 1px;
    border: none;
}

QPushButton#exerciseCardRunButton {
    font-weight: 600;
}

QLabel#goalCardDeadlineLabel {
    font-size: 11px;
}

QLabel#goalCardDescriptionLabel {
    font-size: 12px;
}

/* ---------- Scroll-Bereiche für Card-Grids ---------- */
QScrollArea#exerciseScrollArea,
QScrollArea#historyScrollArea,
QWidget#exerciseCardsWidget,
QWidget#historyEntriesWidget {
    background-color: transparent;
    border: none;
}

/* ---------- Splitter ---------- */
QSplitter::handle {
    background-color: #29292d;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

#roadmapInfoPanel {
    background-color: #19191c;
    border-left: 1px solid #29292d;
}

/* ---------- Scrollbars ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #333338;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #45454b;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #333338;
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: #45454b;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ---------- Statusbar ---------- */
QStatusBar {
    background-color: #0e0e10;
    color: #6d6d73;
    border-top: 1px solid #29292d;
}

/* ---------- Checkbox ---------- */
QCheckBox {
    color: #eaeaec;
    spacing: 8px;
}

QCheckBox {
    color: #eaeaec;
    spacing: 8px;
    background: transparent;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #333338;
    border-radius: 4px;
    background-color: #19191c;
}

QCheckBox::indicator:hover {
    border-color: #ff6f61;
}

QCheckBox::indicator:checked {
    background-color: #ff6f61;
    border-color: #ff6f61;
}

QListWidget#hobbyList {
    background: transparent;
    border: none;
}

QListWidget#hobbyList::item {
    background: transparent;
    border: none;
    padding: 8px 12px;
}

QListWidget#hobbyList::item:selected {
    background: transparent;
    border-left: 2px solid #ff6f61;
}

/* ---------- Roadmap: Overlay-Buttons in der Zeile ---------- */

/* Vier Icon-Buttons, die rechts in der Zeile des ausgewählten
   Steps erscheinen. Sie sind Kinder des Tree-Widgets und werden
   vom Code positioniert. */
QToolButton#roadmapRowAddChildButton,
QToolButton#roadmapRowRenameButton,
QToolButton#roadmapRowToggleDoneButton,
QToolButton#roadmapRowDeleteButton {
    background-color: #212124;
    border: 1px solid #29292d;
    border-radius: 4px;
    padding: 0;
}

QToolButton#roadmapRowAddChildButton:hover,
QToolButton#roadmapRowRenameButton:hover,
QToolButton#roadmapRowToggleDoneButton:hover {
    background-color: #29292d;
    border-color: #333338;
}

QToolButton#roadmapRowDeleteButton:hover {
    background-color: rgba(229, 72, 77, 0.12);
    border-color: rgba(229, 72, 77, 0.35);
}

QToolButton#roadmapRowAddChildButton:disabled,
QToolButton#roadmapRowRenameButton:disabled,
QToolButton#roadmapRowToggleDoneButton:disabled,
QToolButton#roadmapRowDeleteButton:disabled {
    background-color: #19191c;
    border-color: #29292d;
}

/* Detail-Ansicht: Toggle zwischen Hierarchy und Tree. */
QToolButton#roadmapHierarchyViewButton,
QToolButton#roadmapTreeViewButton {
    background-color: #19191c;
    color: #eaeaec;
    border: 1px solid #29292d;
    border-radius: 6px;
    padding: 7px 14px;
    font-size: 13px;
    font-weight: 500;
    border-bottom: 1px solid #29292d;
}

QToolButton#roadmapHierarchyViewButton:hover,
QToolButton#roadmapTreeViewButton:hover {
    background-color: #212124;
    border-color: #333338;
}

QToolButton#roadmapHierarchyViewButton:pressed,
QToolButton#roadmapTreeViewButton:pressed {
    background-color: #29292d;
}

QToolButton#roadmapHierarchyViewButton:checked,
QToolButton#roadmapTreeViewButton:checked {
    background-color: #ff6f61;
    color: #171012;
    border: 1px solid #ff6f61;
    border-bottom: 1px solid #ff6f61;
    font-weight: 600;
}

QToolButton#roadmapHierarchyViewButton:checked:hover,
QToolButton#roadmapTreeViewButton:checked:hover {
    background-color: #ff8677;
    border-color: #ff8677;
    border-bottom: 1px solid #ff8677;
}

/* Platzhalter für die Diagramm-Ansicht. */
QLabel#roadmapTreePlaceholderLabel {
    color: #6d6d73;
    font-size: 13px;
}


/* Der "+ Neuer Step"-Button ist der Primary-Button der Roadmap. */
QPushButton#addRoadmapGoalButton {
    background-color: #ff6f61;
    color: #171012;
    border: 1px solid #ff6f61;
    font-weight: 600;
}

QPushButton#addRoadmapGoalButton:hover {
    background-color: #ff8677;
    border-color: #ff8677;
}

QPushButton#addRoadmapGoalButton:pressed {
    background-color: #e85c4e;
    border-color: #e85c4e;
}

/* Roadmap-Karten: gleicher Look wie Routine-Karten. */
QFrame#roadmapCard {
    background-color: #19191c;
    border: 1px solid #29292d;
    border-radius: 6px;
}

QFrame#roadmapCard:hover {
    border: 1px solid #333338;
}

QLabel#roadmapCardNameLabel {
    font-size: 13px;
    font-weight: 700;
    color: #eaeaec;
}

QLabel#roadmapCardMetaHeaderLabel {
    font-size: 11px;
    font-weight: 600;
    color: #6d6d73;
    padding-top: 8px;
}

QLabel#roadmapCardStatLabel {
    font-size: 11px;
    color: #9a9aa0;
}

/* Mini-Baum in der Card: Root-Step (●) */
QLabel#roadmapCardRootStepLabel {
    font-size: 12px;
    font-weight: 600;
    color: #eaeaec;
}

/* Mini-Baum: Kind-Steps */
QLabel#roadmapCardChildStepLabel {
    font-size: 12px;
    color: #eaeaec;
}

/* Mini-Baum: erledigte Steps (ausgegraut) */
QLabel#roadmapCardCompletedStepLabel {
    font-size: 12px;
    color: #4a4a4f;
}

/* Mini-Baum: "+ N weitere"-Zeile */
QLabel#roadmapCardMoreLabel {
    font-size: 11px;
    color: #6d6d73;
    padding-top: 4px;
}

/* Stern auf der Roadmap-Card */
QToolButton#roadmapCardStarButton {
    background-color: transparent;
    border: none;
    border-bottom: none;
    border-radius: 4px;
    padding: 0;
    margin: 0;
}

QToolButton#roadmapCardStarButton:hover {
    background-color: #212124;
    border-bottom: none;
}

QToolButton#roadmapCardStarButton:pressed {
    background-color: #29292d;
    border-bottom: none;
}

/* Aktiver/Archiv-Toggle in der Roadmap-Übersicht */
QToolButton#roadmapFilterActiveButton,
QToolButton#roadmapFilterArchiveButton {
    background-color: #19191c;
    color: #eaeaec;
    border: 1px solid #29292d;
    border-radius: 6px;
    padding: 7px 14px;
    font-size: 13px;
    font-weight: 500;
    border-bottom: 1px solid #29292d;
}

QToolButton#roadmapFilterActiveButton:hover,
QToolButton#roadmapFilterArchiveButton:hover {
    background-color: #212124;
    border-color: #333338;
}

QToolButton#roadmapFilterActiveButton:pressed,
QToolButton#roadmapFilterArchiveButton:pressed {
    background-color: #29292d;
}

QToolButton#roadmapFilterActiveButton:checked,
QToolButton#roadmapFilterArchiveButton:checked {
    background-color: #ff6f61;
    color: #171012;
    border: 1px solid #ff6f61;
    border-bottom: 1px solid #ff6f61;
    font-weight: 600;
}

QToolButton#roadmapFilterActiveButton:checked:hover,
QToolButton#roadmapFilterArchiveButton:checked:hover {
    background-color: #ff8677;
    border-color: #ff8677;
    border-bottom: 1px solid #ff8677;
}

/* Detail-Seite: Back-Button */
QPushButton#roadmapDetailBackButton {
    background-color: transparent;
    color: #9a9aa0;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 7px 10px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#roadmapDetailBackButton:hover {
    background-color: #212124;
    color: #eaeaec;
}

/* Detail-Seite: Titel — gleiche Größe wie die Section-Header
   auf den anderen Seiten. */
QLabel#roadmapDetailTitleLabel {
    font-size: 16px;
    font-weight: 600;
    color: #eaeaec;
}

/* Roadmap-Tree: Der Delegate zeichnet Auswahl und Inhalte selbst.
   Der Rahmen kommt direkt am Tree. */
QTreeWidget#roadmapTreeWidget {
    background-color: #19191c;
    border: 1px solid #29292d;
    border-radius: 6px;
    outline: none;
    padding: 8px;
}

QTreeWidget#roadmapTreeWidget::item {
    background: transparent;
    border: none;
}

QTreeWidget#roadmapTreeWidget::item:hover {
    background: transparent;
}

QTreeWidget#roadmapTreeWidget::item:selected {
    background: transparent;
    color: #eaeaec;
}


/* ---------- Ziel-Filter ---------- */

/* "Offen"/"Geschafft" (Ziele) und "Aktiv"/"Archiv" (Routinen) verhalten sich wie normale sekundäre
   Filter-Buttons und nicht wie die Hobby-Navigation. */
QToolButton#goalsFilterOpenButton,
QToolButton#goalsFilterDoneButton,
QToolButton#routinesFilterActiveButton,
QToolButton#routinesFilterArchiveButton {
    background-color: #19191c;
    color: #eaeaec;
    border: 1px solid #29292d;
    border-radius: 6px;
    padding: 7px 14px;
    font-size: 13px;
    font-weight: 500;
    border-bottom: 1px solid #29292d;
}

QToolButton#goalsFilterOpenButton:hover,
QToolButton#goalsFilterDoneButton:hover,
QToolButton#routinesFilterActiveButton:hover,
QToolButton#routinesFilterArchiveButton:hover,
QToolButton#roadmapTreeViewButton:hover,
QToolButton#roadmapDiagramViewButton:hover {
    background-color: #212124;
    border-color: #333338;
}

QToolButton#goalsFilterOpenButton:pressed,
QToolButton#goalsFilterDoneButton:pressed,
QToolButton#routinesFilterActiveButton:pressed,
QToolButton#routinesFilterArchiveButton:pressed,
QToolButton#roadmapTreeViewButton:pressed,
QToolButton#roadmapDiagramViewButton:pressed {
    background-color: #29292d;
}

QToolButton#goalsFilterOpenButton:checked,
QToolButton#goalsFilterDoneButton:checked,
QToolButton#routinesFilterActiveButton:checked,
QToolButton#routinesFilterArchiveButton:checked,
QToolButton#roadmapTreeViewButton:checked,
QToolButton#roadmapDiagramViewButton:checked {
    background-color: #ff6f61;
    color: #171012;
    border: 1px solid #ff6f61;
    border-bottom: 1px solid #ff6f61;
    font-weight: 600;
}

QToolButton#goalsFilterOpenButton:checked:hover,
QToolButton#goalsFilterDoneButton:checked:hover,
QToolButton#routinesFilterActiveButton:checked:hover,
QToolButton#routinesFilterArchiveButton:checked:hover,
QToolButton#roadmapTreeViewButton:checked:hover,
QToolButton#roadmapDiagramViewButton:checked:hover {
    background-color: #ff8677;
    border-color: #ff8677;
    border-bottom: 1px solid #ff8677;
}

QToolButton#goalsFilterOpenButton:checked:pressed,
QToolButton#goalsFilterDoneButton:checked:pressed,
QToolButton#routinesFilterActiveButton:checked:pressed,
QToolButton#routinesFilterArchiveButton:checked:pressed,
QToolButton#roadmapTreeViewButton:checked:pressed,
QToolButton#roadmapDiagramViewButton:checked:pressed {
    background-color: #e85c4e;
    border-color: #e85c4e;
    border-bottom: 1px solid #e85c4e;
}
/* ---------- Kopfbereich & Section-Titel ---------- */
QLabel#routineDialogTitleLabel {
    font-size: 16px;
    font-weight: 600;
    color: #eaeaec;
}

QLabel#routineDialogSubtitleLabel {
    font-size: 13px;
    color: #9a9aa0;
}

QLabel#routineExercisesLabel,
QLabel#selectedExercisesLabel {
    font-size: 13px;
    font-weight: 600;
    color: #eaeaec;
}

/* ---------- Übungs-Suche (editierbare ComboBox) mit Icon ----------
   Das Icon (search.svg, 32px breit) liegt als Hintergrund auf der ComboBox.
   Das interne QLineEdit wird transparent und ohne eigene Border/Padding
   gezeichnet, damit keine doppelte Umrandung entsteht. */
QComboBox#routineExerciseComboBox {
    padding-left: 32px;
    background-image: url(:/icons/search.svg);
    background-repeat: no-repeat;
    background-position: left center;
}

QComboBox#routineExerciseComboBox QLineEdit {
    background-color: transparent;
    border: none;
    padding: 0;
}

/* ---------- Empty State (Ausgewählte Übungen) ---------- */
QFrame#selectedExercisesEmptyPage {
    background-color: #19191c;
    border: 1px solid #29292d;
    border-radius: 6px;
}

QLabel#selectedExercisesEmptyTitleLabel {
    font-size: 13px;
    font-weight: 500;
    color: #9a9aa0;
}

QLabel#selectedExercisesEmptyHintLabel {
    font-size: 12px;
    color: #6d6d73;
}

/* ---------- Zeilen: Verfügbare Übungen (dynamisch) ---------- */
QLabel#availableExerciseNameLabel {
    font-size: 13px;
    font-weight: 500;
    color: #eaeaec;
}

QLabel#availableExerciseCategoryTagLabel {
    background-color: #212124;
    color: #9a9aa0;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 11px;
}

/* ---------- Zeilen: Ausgewählte Übungen (dynamisch) ---------- */
QFrame#selectedExerciseRow {
    background-color: transparent;
    border: none;
}

QLabel#selectedExerciseNameLabel {
    font-size: 13px;
    font-weight: 500;
    color: #eaeaec;
}

QLabel#selectedExerciseUnitLabel {
    font-size: 13px;
    color: #9a9aa0;
}

/* Aktions-Buttons (↑ ↓ ×): kompakte Ghost-QToolButtons (24x24 aus der .ui).
   Überschreiben die globale QToolButton-Tab-Optik (Padding, Unterkante). */
QToolButton#selectedExerciseMoveUpButton,
QToolButton#selectedExerciseMoveDownButton,
QToolButton#selectedExerciseRemoveButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 0;
}

QToolButton#selectedExerciseMoveUpButton:hover,
QToolButton#selectedExerciseMoveDownButton:hover {
    background-color: #212124;
}

QToolButton#selectedExerciseMoveUpButton:pressed,
QToolButton#selectedExerciseMoveDownButton:pressed {
    background-color: #29292d;
}

/* Entfernen: destruktiv, dezent über rote Hover-Fläche (kein Mülltonnen-Icon) */
QToolButton#selectedExerciseRemoveButton:hover {
    background-color: rgba(229, 72, 77, 0.12);
}

QToolButton#selectedExerciseRemoveButton:pressed {
    background-color: rgba(229, 72, 77, 0.20);
}

QToolButton#selectedExerciseMoveUpButton:focus,
QToolButton#selectedExerciseMoveDownButton:focus,
QToolButton#selectedExerciseRemoveButton:focus {
    border: 1px solid #ff6f61;
}

/* Listen-Items der Routine: kein eigenes Padding.
   Die Row (setItemWidget) wird vom Delegate in das Item-Rechteck MINUS Item-Padding
   gesetzt. Das globale "QListWidget::item { padding: 6px 8px }" verkleinert sie sonst
   um 12px in der Höhe, die Row rutscht nach unten und wird abgeschnitten. */
QListWidget#selectedExercisesList::item {
    padding: 0;
}

/* Dauer-Feld in der Row: kompakter als das globale QSpinBox (6px 10px),
   damit es in die 32px Nutzhöhe der Row passt und der Text nicht abgeschnitten wird. */
QSpinBox#selectedExerciseDurationSpinBox {
    padding: 3px 8px;
}

/* ---------- QSpinBox (fehlt bisher in theme.qss) ---------- */
QSpinBox {
    background-color: #19191c;
    border: 1px solid #29292d;
    border-radius: 6px;
    padding: 6px 10px;
    color: #eaeaec;
    selection-background-color: #ff6f61;
    selection-color: #171012;
}

QSpinBox:hover {
    border-color: #333338;
}

QSpinBox:focus {
    border-color: #ff6f61;
}

QSpinBox:disabled {
    background-color: #17171a;
    color: #55555a;
}

QSpinBox::up-button, QSpinBox::down-button {
    width: 0px;
    border: none;
}

/* ---------- Footer: Primary-Action ---------- */
QPushButton#routineSaveButton {
    background-color: #ff6f61;
    color: #171012;
    border: 1px solid #ff6f61;
    font-weight: 600;
}

QPushButton#routineSaveButton:hover {
    background-color: #ff8677;
    border-color: #ff8677;
}

QPushButton#routineSaveButton:pressed {
    background-color: #e85c4e;
    border-color: #e85c4e;
}

QPushButton#routineSaveButton:disabled {
    background-color: #17171a;
    color: #55555a;
    border-color: #212124;
}

/* ---------- Routine-Ausführung (routineExecutionPage) ---------- */

QScrollArea#routineExecutionExerciseList,
QWidget#routineExecutionExerciseListContainer,
QFrame#routineExecutionExerciseDetail {
    background: transparent;
    border: none;
}

/* Trennlinie über der unteren Zeile (volle Fensterbreite) */
QFrame#routineExecutionNavigationSeparator {
    background-color: #29292d;
    border: none;
    max-height: 1px;
}

QLabel#routineExecutionExerciseNameLabel,
ClickableLabel#routineExecutionExerciseNameLabel {
    font-size: 32px;
    font-weight: 600;
    color: #eaeaec;
}

ClickableLabel#routineExecutionExerciseNameLabel:hover,
ClickableLabel#exerciseExecutionExerciseNameLabel:hover {
    color: #ff6f61;
}

QLabel#routineExecutionExerciseDescriptionLabel {
    font-size: 16px;
    color: #9a9aa0;
}

/* Beschriftungen über den Werten (Wert / Neu / Ziel) */
QLabel#routineExecutionExerciseTargetHeaderLabel,
QLabel#routineExecutionExerciseCurrentValueHeaderLabel,
QLabel#routineExecutionExerciseNewValueHeaderLabel {
    font-size: 20px;
    font-weight: 600;
    color: #9a9aa0;
}

QLabel#routineExecutionExerciseTargetLabel,
QLabel#routineExecutionExerciseCurrentValueLabel {
    font-size: 28px;
    font-weight: 600;
    color: #eaeaec;
}

QLineEdit#routineExecutionExerciseValueEdit {
    font-size: 28px;
    font-weight: 600;
    padding: 4px 12px;
}

QLabel#routineExecutionExerciseUnitLabel {
    font-size: 16px;
    color: #9a9aa0;
}

/* Countdown: bewusst der größte Text der Oberfläche */
QLabel#routineExecutionTimerLabel {
    font-size: 96px;
    font-weight: 600;
    color: #eaeaec;
}

/* Inline-Bearbeitung des Routine-Timers */
QLineEdit#routineExecutionTimerEdit {
    font-size: 96px;
    font-weight: 600;
    color: #eaeaec;
    background-color: #19191c;
    border: 2px solid #ff6f61;
    border-radius: 6px;
    padding: 4px 12px;
}

QProgressBar#routineExecutionProgressBar {
    background-color: #19191c;
    border: 1px solid #29292d;
    border-radius: 4px;
    height: 16px;
    max-height: 16px;
}

QProgressBar#routineExecutionProgressBar::chunk {
    background-color: #ff6f61;
    border-radius: 4px;
}

QPushButton#routineExecutionStartPauseButton,
QPushButton#routineExecutionStopButton {
    icon-size: 24px;
    font-size: 24px;
}

/* Pfeile und Übungsbuttons unten: gleiche Schrift (13px), Höhe 36px
   (Pfeile fix in der .ui, Übungsbuttons per setFixedHeight(36)). */
QPushButton#routineExecutionPreviousButton,
QPushButton#routineExecutionNextButton,
QPushButton#routineExecutionExerciseButton {
    font-size: 13px;
}

/* Übungs-Auswahl unten: dynamisch erzeugte, checkbare QPushButtons mit
   objectName "routineExecutionExerciseButton". Inaktiv = Secondary
   (Standard-QPushButton), aktiv (:checked) = Accent wie die Primary-Buttons. */
QPushButton#routineExecutionExerciseButton:checked {
    background-color: #ff6f61;
    color: #171012;
    border: 1px solid #ff6f61;
    font-weight: 600;
}

QPushButton#routineExecutionExerciseButton:checked:hover {
    background-color: #ff8677;
    border-color: #ff8677;
}

QPushButton#routineExecutionExerciseButton:checked:pressed {
    background-color: #e85c4e;
    border-color: #e85c4e;
}

/* ---------- Übungs-Ausführung (exerciseExecutionPage) ---------- */

/* Gleiche Optik wie die Routine-Ausführung, nur mit eigenen Objektnamen. */

QFrame#exerciseExecutionExerciseDetail {
    background: transparent;
    border: none;
}

QLabel#exerciseExecutionExerciseNameLabel,
ClickableLabel#exerciseExecutionExerciseNameLabel {
    font-size: 32px;
    font-weight: 600;
    color: #eaeaec;
}

QLabel#exerciseExecutionExerciseDescriptionLabel {
    font-size: 16px;
    color: #9a9aa0;
}

/* Beschriftungen über den Werten (Wert / Neu / Ziel) */
QLabel#exerciseExecutionExerciseTargetHeaderLabel,
QLabel#exerciseExecutionExerciseCurrentValueHeaderLabel,
QLabel#exerciseExecutionExerciseNewValueHeaderLabel {
    font-size: 20px;
    font-weight: 600;
    color: #9a9aa0;
}

QLabel#exerciseExecutionExerciseTargetLabel,
QLabel#exerciseExecutionExerciseCurrentValueLabel {
    font-size: 28px;
    font-weight: 600;
    color: #eaeaec;
}

QLineEdit#exerciseExecutionExerciseValueEdit {
    font-size: 28px;
    font-weight: 600;
    padding: 4px 12px;
}

QLabel#exerciseExecutionExerciseUnitLabel {
    font-size: 16px;
    color: #9a9aa0;
}

/* Countdown: gleiche Größe wie in der Routine-Ausführung. */
QLabel#exerciseExecutionTimerLabel {
    font-size: 96px;
    font-weight: 600;
    color: #eaeaec;
}

/* Inline-Bearbeitung des Übungs-Timers */
QLineEdit#exerciseExecutionTimerEdit {
    font-size: 96px;
    font-weight: 600;
    color: #eaeaec;
    background-color: #19191c;
    border: 2px solid #ff6f61;
    border-radius: 6px;
    padding: 4px 12px;
}

QProgressBar#exerciseExecutionProgressBar {
    background-color: #19191c;
    border: 1px solid #29292d;
    border-radius: 4px;
    height: 16px;
    max-height: 16px;
}

QProgressBar#exerciseExecutionProgressBar::chunk {
    background-color: #ff6f61;
    border-radius: 4px;
}

QPushButton#exerciseExecutionStartPauseButton,
QPushButton#exerciseExecutionStopButton {
    icon-size: 24px;
    font-size: 24px;
}

QTreeWidget#roadmapTreeWidget {
    background-color: #19191c;
    border: 1px solid #29292d;
    border-radius: 6px;
    padding: 8px;
}
QFrame#roadmapCard:hover {
    border: 1px solid #333338;
}